		"js-yaml": "^4.1.0",
		"zod": "^3.25.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@cloudflare/workers-types": "^5",
		"@types/js-yaml": "^4.0.9",
		"typescript": "^5.7.0",
		"wrangler": "^4.40.0"
	}
