{
	"name": "signpost",
	"type": "module",
	"version": "0.1.0",
	"license": "MIT",
	"description": "Own, agent-editable, open-source link-in-bio. Static Astro on Cloudflare.",
	"scripts": {
		"predev": "node scripts/prebuild.mjs",
		"dev": "astro dev",
		"prebuild": "node scripts/prebuild.mjs",
		"build": "astro build",
		"preview": "astro preview",
		"check": "biome check .",
