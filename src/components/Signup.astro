---
// Posts to the signup Worker (/api/subscribe). Progressive enhancement: works as a
// plain POST with no JS; with JS it submits in place and shows inline feedback.
const consent = Astro.props.consent ?? "Weekly build log. No spam. Unsubscribe anytime.";
---

<form class="signup" method="post" action="/api/subscribe" data-signup>
	<input type="email" name="email" placeholder="you@email.com" required aria-label="Email" />
	<input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
	<button type="submit">Join</button>
</form>
<p class="consent" data-consent aria-live="polite">{consent}</p>

<script is:inline>
	const form = document.querySelector("form[data-signup]");
	const note = document.querySelector("[data-consent]");
	form?.addEventListener("submit", async (e) => {
		e.preventDefault();
		const btn = form.querySelector("button");
		btn.disabled = true;
		try {
			const res = await fetch(form.action, {
				method: "POST",
				headers: { "content-type": "application/json" },
				body: JSON.stringify(Object.fromEntries(new FormData(form))),
			});
			if (res.ok) {
				form.style.display = "none";
				if (note) {
					note.textContent = "Thanks — you're on the list.";
					note.style.color = "var(--accent)";
				}
			} else {
				btn.disabled = false;
				if (note) note.textContent = "That email didn't look right. Try again.";
			}
		} catch {
			btn.disabled = false;
			if (note) note.textContent = "Something went wrong. Try again.";
		}
	});
</script>
